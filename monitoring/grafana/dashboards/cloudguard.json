{
  "uid": "cloudguard-overview",
  "title": "CloudGuard - Preview Environments",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running containers",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "count(container_last_seen{name!=\"\"})" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU usage per container (%)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{name}}",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])) * 100"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory usage per container",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{name}}",
          "expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\"})"
        }
      ]
    }
  ]
}
